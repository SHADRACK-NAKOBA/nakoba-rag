# ═══════════════════════════════════════════════════════════
# Nakoba Advanced RAG — Environment Configuration
# cp config/.env.example config/.env  then fill in values
# NEVER commit config/.env  (it is in .gitignore)
# ═══════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# ── GCP / Vertex AI ──────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Anthropic Claude via Vertex AI  (must be us-east5)
VERTEX_CLAUDE_MODEL=claude-sonnet-4-6
VERTEX_CLAUDE_LOCATION=us-east5

# ── Vector Store (ChromaDB for dev, Vertex for prod) ─────────
VECTOR_STORE_BACKEND=chroma            # chroma | vertex
CHROMA_PERSIST_DIR=./data/chroma_db
VERTEX_INDEX_ID=your-vertex-index-id
VERTEX_ENDPOINT_ID=your-vertex-endpoint-id
VERTEX_DEPLOYED_INDEX_ID=your-deployed-index-id
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# ── MCP Gateway ──────────────────────────────────────────────
MCP_GATEWAY_URL=http://localhost:8080
MCP_GATEWAY_API_KEY=local-dev-key-change-in-prod

# ── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_IDP_URL=https://your-idp.example.com

# ── Cache (Redis) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_FAKE_REDIS=true           # true for local dev without Redis

# ── GCS ───────────────────────────────────────────────────────
GCS_BUCKET=nakoba-rag-data

# ── BigQuery Audit ────────────────────────────────────────────
BQ_DATASET=nakoba_audit
BQ_AUDIT_TABLE=gateway_events

# ── HITL Notifications ────────────────────────────────────────
HITL_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Live Source Systems ────────────────────────────────────────
ZABBIX_URL=https://zabbix.your-company.com
ZABBIX_TOKEN=your-zabbix-api-token

DYNATRACE_URL=https://abc12345.live.dynatrace.com
DYNATRACE_TOKEN=your-dynatrace-token

SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USER=svc-nakoba
SERVICENOW_PASS=your-servicenow-password

JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=svc-nakoba@your-org.com
JIRA_TOKEN=your-jira-api-token

CONFLUENCE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_TOKEN=your-confluence-token

GCP_OBS_PROJECT=your-observability-project

SENTINEL_ONE_URL=https://your-console.sentinelone.net
SENTINEL_ONE_TOKEN=your-sentinel-token

PUPPET_URL=https://puppet.your-company.com:8143
PUPPET_TOKEN=your-puppet-token

LEANIX_URL=
LEANIX_TOKEN=